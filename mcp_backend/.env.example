# Express server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# API key auth (recommended for all non-local usage)
MCP_API_KEY=change-me

# PostgreSQL connection strings
# Use POSTGRES_URL for both RO and RW, or split with POSTGRES_URL_RO/POSTGRES_URL_RW.
POSTGRES_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# POSTGRES_URL_RO=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# POSTGRES_URL_RW=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Pool tuning (optional)
PG_POOL_MAX=10
PG_POOL_IDLE_TIMEOUT_MS=30000
PG_POOL_CONN_TIMEOUT_MS=5000
